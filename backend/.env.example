APP_NAME=Sift
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
SIFT_FRONTEND_URL=http://localhost:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=sift
DB_USERNAME=sift
DB_PASSWORD=sift_local

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
DEMO_MODE_ENABLED=false
DEMO_USER_ID=
DEMO_WORKSPACE_ID=
DEMO_ASSISTANT_ENABLED=false
DEMO_ASSISTANT_PER_MINUTE=3
DEMO_ASSISTANT_PER_HOUR_PER_IP=15
DEMO_ASSISTANT_PER_DAY=100
DEMO_ASSISTANT_MAX_QUESTION_LENGTH=500
DEMO_ENTRY_PER_HOUR_PER_IP=10
DEMO_WIDGET_ENABLED=false
DEMO_WIDGET_PER_MINUTE_PER_IP=3
DEMO_WIDGET_PER_HOUR_PER_IP=15
DEMO_WIDGET_PER_DAY=100
DEMO_WIDGET_MAX_QUESTION_LENGTH=500
DEMO_WIDGET_MAXIMUM_REQUEST_BYTES=8192

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
DOCUMENTS_DISK=local
DOCUMENT_UPLOAD_MAX_KB=20480
DOCUMENT_MIN_EXTRACTED_CHARACTERS=50
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200
EMBEDDING_PROVIDER=cohere
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=64
COHERE_API_KEY=
COHERE_EMBEDDING_MODEL=embed-v4.0
COHERE_BASE_URL=https://api.cohere.com
COHERE_CONNECT_TIMEOUT=5
COHERE_TIMEOUT=30
COHERE_MAX_ATTEMPTS=3
COHERE_RETRY_DELAY_MS=200
RETRIEVER=pgvector
RAG_RETRIEVAL_TOP_K=5
RAG_RETRIEVAL_MIN_SIMILARITY=
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CONNECT_TIMEOUT=5
GROQ_TIMEOUT=30
GROQ_MAX_ATTEMPTS=3
GROQ_RETRY_DELAY_MS=200
GROQ_REASONING_EFFORT=low
RAG_CONTEXT_MAX_CHUNKS=5
RAG_CONTEXT_MAX_CHARACTERS=12000
RAG_MAX_OUTPUT_TOKENS=600
RAG_TEMPERATURE=0
QUEUE_CONNECTION=database
DB_QUEUE=documents
DB_QUEUE_RETRY_AFTER=360
DOCUMENT_PROCESSING_QUEUE=documents
DOCUMENT_PROCESSING_TIMEOUT=300
TEAM_INVITATION_TTL_DAYS=7
WIDGET_CONVERSATION_LIFETIME_MINUTES=1440
WIDGET_BOOTSTRAP_REQUESTS_PER_MINUTE=60
WIDGET_SESSION_CREATIONS_PER_HOUR=10
WIDGET_MESSAGES_PER_MINUTE_PER_CONVERSATION=5
WIDGET_MESSAGES_PER_HOUR_PER_IP_WIDGET=30
WIDGET_MESSAGES_PER_DAY_PER_WIDGET=500
WIDGET_MAXIMUM_QUESTION_LENGTH=1000
WIDGET_MAXIMUM_REQUEST_BYTES=8192

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
